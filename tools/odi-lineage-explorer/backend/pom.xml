<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.openmetadata.tools</groupId>
  <artifactId>odi-lineage-explorer-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>ODI Lineage Explorer Backend</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <assertj.version>3.27.3</assertj.version>
    <jackson.version>2.18.9</jackson.version>
    <junit.version>5.11.4</junit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <json.version>20240303</json.version>
    <mockito.version>5.15.2</mockito.version>
    <odi.sdk.lib.dir>${user.home}/.local/share/oracle/odi/14.1.2/lib</odi.sdk.lib.dir>
    <spotless.version>2.41.1</spotless.version>
    <surefire.version>3.1.2</surefire.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>${json.version}</version>
    </dependency>
    <dependency>
      <groupId>com.oracle.odi</groupId>
      <artifactId>oracle-odi-common-clientlib</artifactId>
      <version>14.1.2.0.0</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/oracle.odi.common.clientLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.oracle.odi</groupId>
      <artifactId>oracle-odi-third-party-clientlib</artifactId>
      <version>14.1.2.0.0</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/oracle.odi.tp.clientLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.oracle.odi</groupId>
      <artifactId>oracle-odi-sdk-clientlib</artifactId>
      <version>14.1.2.0.0</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/oracle.odi.sdk.clientLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>23.5.0.24.07</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/ojdbc11.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.19.2</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>org.openmetadata.tools.odi.explorer.OdiExplorerApplication</mainClass>
          <additionalClasspathElements>
            <additionalClasspathElement>${odi.sdk.lib.dir}/oracle.odi.common.clientLib.jar</additionalClasspathElement>
            <additionalClasspathElement>${odi.sdk.lib.dir}/oracle.odi.tp.clientLib.jar</additionalClasspathElement>
            <additionalClasspathElement>${odi.sdk.lib.dir}/oracle.odi.sdk.clientLib.jar</additionalClasspathElement>
            <additionalClasspathElement>${odi.sdk.lib.dir}/ojdbc11.jar</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
