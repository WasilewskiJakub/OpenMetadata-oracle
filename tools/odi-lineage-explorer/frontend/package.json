{
  "name": "@openmetadata-oracle/odi-lineage-explorer-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
