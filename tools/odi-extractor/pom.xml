<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.open-metadata</groupId>
    <artifactId>platform</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>odi-sdk-extractor</artifactId>
  <name>ODI SDK Extractor</name>
  <description>Private-classpath development tool for extracting ODI mapping metadata.</description>
  <packaging>jar</packaging>

  <properties>
    <odi.sdk.lib.dir>${user.home}/.local/share/oracle/odi/14.1.2/lib</odi.sdk.lib.dir>
    <odi.sdk.version>14.1.2.0.0</odi.sdk.version>
    <odi.jdbc.version>23.5.0.24.07</odi.jdbc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.oracle.odi</groupId>
      <artifactId>oracle.odi.common.clientLib</artifactId>
      <version>${odi.sdk.version}</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/oracle.odi.common.clientLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.oracle.odi</groupId>
      <artifactId>oracle.odi.tp.clientLib</artifactId>
      <version>${odi.sdk.version}</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/oracle.odi.tp.clientLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.oracle.odi</groupId>
      <artifactId>oracle.odi.sdk.clientLib</artifactId>
      <version>${odi.sdk.version}</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/oracle.odi.sdk.clientLib.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${odi.jdbc.version}</version>
      <scope>system</scope>
      <systemPath>${odi.sdk.lib.dir}/ojdbc11.jar</systemPath>
    </dependency>
  </dependencies>
</project>
